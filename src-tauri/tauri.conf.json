{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cadze",
  "version": "0.2.0",
  "identifier": "com.sedattelli.cadze",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cadze",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis", "msi"],
    "resources": {
      "resources/bin/dwg2dxf.exe": "bin/dwg2dxf.exe",
      "resources/bin/libredwg-0.dll": "bin/libredwg-0.dll",
      "resources/bin/libiconv-2.dll": "bin/libiconv-2.dll",
      "resources/bin/libpcre2-8-0.dll": "bin/libpcre2-8-0.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["dxf", "dwg"], "name": "CAD File", "description": "AutoCAD Drawing" }
    ]
  }
}
